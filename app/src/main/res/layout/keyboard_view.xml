<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_keyboard_hide"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Spans the width between the back button and the cancel/retry corner, wrapping to
             a second line rather than truncating, so longer messages stay readable. Fixed
             margins (not toStartOf) keep the layout stable when those buttons are GONE. -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="52dp"
            android:layout_marginEnd="48dp"
            android:gravity="center"
            android:text="Touch and speak"
            android:maxLines="2"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <!-- Cancels the in-flight transcription / cleanup; only visible while processing -->
        <ImageButton
            android:id="@+id/btn_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_cancel_button"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            android:visibility="gone"
            android:contentDescription="Cancel" />

        <!-- Re-runs a failed transcription/cleanup from the saved audio; visible only after a failure -->
        <ImageButton
            android:id="@+id/btn_retry"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_retry_button"
            android:src="@drawable/ic_retry"
            android:padding="8dp"
            android:visibility="gone"
            android:contentDescription="Retry" />
    </RelativeLayout>

    <!-- Edit mode: the spoken instruction (live, then final) so the user can check it -->
    <TextView
        android:id="@+id/tv_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_transcript_box"
        android:padding="10dp"
        android:maxLines="4"
        android:scrollbars="vertical"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:visibility="gone" />

    <!-- Middle Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">
            <!-- Large circular mic button (scales with mic level; must not be cropped) -->
            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_mic_button"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_backspace" />
    </LinearLayout>

    <!-- Modify Row: smaller circular button mirroring the mic button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/btn_modify"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_mic_button"
            android:src="@drawable/ic_edit"
            android:padding="12dp"
            android:contentDescription="Modify text" />
    </LinearLayout>

    <!-- Bottom Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="CheapWhisper"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Current transcription model, language and cleanup model (from Settings) -->
        <TextView
            android:id="@+id/tv_config"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Bottom-right: total third-party spend; tap to expand the breakdown below. -->
        <TextView
            android:id="@+id/btn_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="$0.0000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <!-- Expanded per-provider cost breakdown (toggled by btn_cost) -->
    <LinearLayout
        android:id="@+id/cost_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_cost_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

</LinearLayout>